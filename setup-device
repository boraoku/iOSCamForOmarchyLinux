#!/bin/bash
# Privileged helper: create the "iPhone Camera" v4l2loopback device now and at boot.
# Invoked with pkexec/sudo from the panel or ./setup.
#
#   install     create the module config, boot unit, and device
#   uninstall   remove them
#   status      print JSON
set -euo pipefail
export LC_ALL=C
export PATH="/usr/bin:/usr/sbin:/bin:/sbin:${PATH:-}"

LABEL="iPhone Camera"
NR=42
UNIT=/etc/systemd/system/omarchy-iphone-camera-device.service
MODLOAD=/etc/modules-load.d/omarchy-iphone-camera.conf
MODPROBE=/etc/modprobe.d/omarchy-iphone-camera.conf
LIBDIR=/usr/local/lib/omarchy-iphone-camera
CTL=/usr/bin/v4l2loopback-ctl

need_root() { [[ $EUID -eq 0 ]] || { echo "must run as root (pkexec/sudo)" >&2; exit 1; }; }

device_path() {
  v4l2-ctl --list-devices 2>/dev/null | awk -v l="$LABEL" '
    $0 ~ l ":" {grab=1; next}
    grab && /\/dev\/video[0-9]+/ { print $1; exit }
    $0 ~ /:$/ { grab=0 }
  '
}

ensure_packages() {
  local pkgs=() krel flavour=linux
  krel=$(uname -r)
  [[ -x $CTL ]] || pkgs+=(v4l2loopback-utils)
  pacman -Q v4l2loopback-dkms >/dev/null 2>&1 || pkgs+=(v4l2loopback-dkms)
  pacman -Q dkms >/dev/null 2>&1 || pkgs+=(dkms)
  if [[ ! -e /usr/lib/modules/$krel/build ]]; then
    case "$krel" in *-zen*) flavour=linux-zen;; *-lts*) flavour=linux-lts;; *-hardened*) flavour=linux-hardened;; *-rt-lts*) flavour=linux-rt-lts;; *-rt*) flavour=linux-rt;; esac
    pacman -Q "$flavour" >/dev/null 2>&1 && pkgs+=("${flavour}-headers")
  fi
  ((${#pkgs[@]})) || return 0
  echo "Installing ${pkgs[*]}…"
  pacman -S --noconfirm --needed "${pkgs[@]}"
  hash -r
}

ensure_module() {
  local krel; krel=$(uname -r)
  if ! modprobe v4l2loopback 2>/dev/null; then
    if [[ -e /usr/lib/modules/$krel/build ]] && command -v dkms >/dev/null; then
      echo "Building v4l2loopback for $krel…"
      dkms autoinstall -k "$krel" >/dev/null 2>&1 || dkms autoinstall >/dev/null 2>&1 || true
      modprobe v4l2loopback 2>/dev/null || true
    fi
  fi
  if [[ ! -e /dev/v4l2loopback ]] && ! lsmod | grep -q '^v4l2loopback'; then
    echo "v4l2loopback did not load for kernel $krel. Try: pacman -S linux-headers v4l2loopback-dkms && dkms autoinstall" >&2
    exit 1
  fi
}

loopback_in_use() {
  local used
  used=$(lsmod | awk '/^v4l2loopback/ {print $3; exit}')
  [[ -n $used && $used -gt 0 ]]
}

add_device() {
  local existing
  existing=$(device_path || true)
  if [[ -n $existing ]]; then
    echo "already present: $existing"
    return 0
  fi

  if [[ -x $CTL ]]; then
    if "$CTL" add -n "$LABEL" -x 1 -o 16 /dev/video$NR; then
      return 0
    fi
    if "$CTL" add -n "$LABEL" -x 1 /dev/video$NR; then
      return 0
    fi
  fi

  # devices=0 is loaded and ctl could not add: reload if nothing is using the module.
  if lsmod | grep -q '^v4l2loopback' && ! loopback_in_use; then
    echo "Reloading v4l2loopback to create '$LABEL'…"
    rmmod v4l2loopback
    # Command-line options override modprobe.d for this load.
    modprobe v4l2loopback exclusive_caps=1 "card_label=$LABEL" video_nr=$NR devices=1
    return 0
  fi

  echo "could not create '$LABEL'. Install v4l2loopback-utils and retry." >&2
  return 1
}

install_self() {
  install -d -m 755 "$LIBDIR"
  local self; self=$(readlink -f "$0")
  [[ $self == "$LIBDIR/setup-device" ]] && return 0
  install -m 755 -o root -g root "$self" "$LIBDIR/setup-device"
}

cmd_install() {
  need_root
  ensure_packages
  if [[ ! -x $CTL ]]; then
    echo "v4l2loopback-ctl is still missing after package install" >&2
    exit 1
  fi
  if ! grep -qs '^[[:space:]]*options[[:space:]]\+v4l2loopback\b' /etc/modprobe.d/*.conf /usr/lib/modprobe.d/*.conf 2>/dev/null; then
    echo "options v4l2loopback devices=0" > "$MODPROBE"
  fi
  echo v4l2loopback > "$MODLOAD"
  ensure_module
  cat > "$UNIT" <<EOF
[Unit]
Description=iPhone Camera virtual video device
After=systemd-modules-load.service
ConditionPathExists=/dev/v4l2loopback

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c '$CTL list 2>/dev/null | grep -q "$LABEL" || $CTL add -n "$LABEL" -x 1 -o 16 /dev/video$NR'

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
  systemctl enable omarchy-iphone-camera-device.service >/dev/null 2>&1 || true
  add_device
  systemctl reset-failed omarchy-iphone-camera-device.service >/dev/null 2>&1 || true
  systemctl restart omarchy-iphone-camera-device.service
  install_self

  sleep 0.4
  local dev; dev=$(device_path || true)
  if [[ -z $dev ]]; then
    echo "the virtual camera was not created. systemctl status omarchy-iphone-camera-device; dkms status" >&2
    exit 1
  fi
  # Seat ACL so OBS/the user can open it without being in group video.
  if command -v udevadm >/dev/null; then
    udevadm trigger --subsystem-match=video4linux --action=change >/dev/null 2>&1 || true
    udevadm settle --timeout=3 >/dev/null 2>&1 || true
  fi
  echo "virtual camera: $dev"
}

cmd_uninstall() {
  need_root
  systemctl disable --now omarchy-iphone-camera-device.service >/dev/null 2>&1 || true
  rm -f "$UNIT" "$MODLOAD" "$MODPROBE"
  systemctl daemon-reload
  local dev; dev=$(device_path || true)
  if [[ -n $dev && -x $CTL ]]; then
    "$CTL" delete "$dev" || true
  fi
  rm -rf "$LIBDIR"
  echo "removed virtual camera boot unit"
}

cmd_status() {
  local dev; dev=$(device_path || true)
  local unit=false; [[ -f $UNIT ]] && unit=true
  printf '{"device":"%s","bootUnit":%s}\n' "$dev" "$unit"
}

case "${1:-}" in
  install) cmd_install ;;
  uninstall) cmd_uninstall ;;
  status) cmd_status ;;
  *) echo "usage: setup-device {install|uninstall|status}" >&2; exit 2 ;;
esac
